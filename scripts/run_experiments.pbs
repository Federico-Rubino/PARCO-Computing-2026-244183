#!/bin/bash
#PBS -N sssp_bench
#PBS -l select=1:ncpus=64:mem=16gb
#PBS -l walltime=04:00:00
#PBS -q shortCPUQ
#PBS -o logs/sssp_bench.log
#PBS -e logs/sssp_bench.err

set -euo pipefail
cd "$PBS_O_WORKDIR"

: "${GRAPH:?set via: qsub -v GRAPH=data/foo.txt,UNDIRECTED=0,DELTA=10,SCHEDULE=dynamic_64 run_experiments.pbs}"
: "${UNDIRECTED:=0}"
: "${DELTA:=10}"
: "${SCHEDULE:=dynamic_64}"
SCHEDULE="${SCHEDULE//_/,}"   # qsub -v splits on comma, so it arrives underscore-encoded

module load GCC/13.3.0

make dsa dijkstra

./scripts/run_experiments.sh "$GRAPH" "$UNDIRECTED" "$DELTA" "$SCHEDULE"
