#!/bin/bash
#PBS -N sssp_bench
#PBS -l select=1:ncpus=64:mem=16gb
#PBS -l walltime=04:00:00
#PBS -q shortCPUQ
#PBS -o logs/sssp_bench.log
#PBS -e logs/sssp_bench.err

set -euo pipefail
cd "$PBS_O_WORKDIR"

: "${GRAPH:?set via: qsub -v GRAPH=data/foo.txt,UNDIRECTED=0,DELTA=10,SCHEDULE=dynamic_64 run_experiments.pbs}"
: "${UNDIRECTED:=0}"
: "${DELTA:=10}"
: "${SCHEDULE:=dynamic_64}"
SCHEDULE="${SCHEDULE//_/,}"   # qsub -v splits on comma, so it arrives underscore-encoded

module load GCC/13.3.0

# built once, before submitting -- never rebuild here: with several of
# these jobs running concurrently, each doing "make" would race on the
# same shared bin/dsa, bin/wasp and bin/dijkstra files (seen in practice
# as a linker "Stale file handle" in one job and a segfault, from the
# binary being overwritten mid-execution, in another)
[ -x bin/dsa ] && [ -x bin/wasp ] && [ -x bin/dijkstra ] || {
    echo "bin/dsa, bin/wasp or bin/dijkstra missing/not executable -- run 'make dsa wasp dijkstra' once, before submitting, not inside the job" >&2
    exit 1
}

./scripts/run_experiments.sh "$GRAPH" "$UNDIRECTED" "$DELTA" "$SCHEDULE"
