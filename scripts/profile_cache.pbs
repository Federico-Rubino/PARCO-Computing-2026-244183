#!/bin/bash
#PBS -N cache_profile
#PBS -l select=1:ncpus=64:mem=64gb
#PBS -l walltime=05:00:00
#PBS -q shortCPUQ

set -euo pipefail
cd "$PBS_O_WORKDIR"

: "${GRAPH:?set via: qsub -v GRAPH=data/foo.txt,UNDIRECTED=0,DELTA=10,ALGO=dsa,THREADS=1_4 profile_cache.pbs}"
: "${UNDIRECTED:=0}"
: "${DELTA:=10}"
: "${ALGO:=all}"
: "${THREADS:=1_4_16_64}"
THREADS="${THREADS//_/,}"   # qsub -v splits on comma, so it arrives underscore-encoded

module load GCC/13.3.0

# built once before submitting; concurrent rebuilds race on the shared binaries
[ -x bin/dsa_prof ] && [ -x bin/wasp_prof ] && [ -x bin/dijkstra_prof ] || {
    echo "bin/dsa_prof, bin/wasp_prof or bin/dijkstra_prof missing/not executable -- run 'make dsa_prof wasp_prof dijkstra_prof' once, before submitting, not inside the job" >&2
    exit 1
}

./scripts/profile_cache.sh "$GRAPH" "$UNDIRECTED" "$DELTA" "dynamic,256" "$ALGO" "$THREADS"
